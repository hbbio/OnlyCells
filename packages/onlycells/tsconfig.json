{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@onlycells/core",
    "paths": {
      "@onlycells/core": ["./src/index.ts"],
      "@onlycells/core/jsx-runtime": ["./src/jsx-runtime.ts"],
      "@onlycells/core/jsx-dev-runtime": ["./src/jsx-dev-runtime.ts"]
    }
  },
  "include": ["src", "test-types"]
}
